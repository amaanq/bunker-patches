bcachefs: call sort and sort_r now that linux-next dropped the nonatomic variants

linux-next removed sort_nonatomic() and sort_r_nonatomic(), and
bcachefs 1.39.7 still calls them.

diff -ruN a/src/fs/bcachefs/btree/journal_overlay.c b/src/fs/bcachefs/btree/journal_overlay.c
--- a/src/fs/bcachefs/btree/journal_overlay.c	2026-11-10 17:23:22.947415576 -0500
+++ b/src/fs/bcachefs/btree/journal_overlay.c	2026-11-10 17:23:22.952336009 -0500
@@ -792,7 +792,7 @@
 {
 	struct bch_fs *c = container_of(keys, struct bch_fs, journal_keys);
 
-	sort_r_nonatomic(keys->data, keys->nr, sizeof(keys->data[0]),
+	sort_r(keys->data, keys->nr, sizeof(keys->data[0]),
 			 journal_sort_key_cmp, NULL, c);
 
 	cond_resched();
diff -ruN a/src/fs/bcachefs/btree/node_scan.c b/src/fs/bcachefs/btree/node_scan.c
--- a/src/fs/bcachefs/btree/node_scan.c	2026-11-10 17:23:22.957893062 -0500
+++ b/src/fs/bcachefs/btree/node_scan.c	2026-11-10 17:23:22.962977432 -0500
@@ -396,7 +396,7 @@
 		bch2_print_str(c, KERN_INFO, buf.buf);
 	}
 
-	sort_nonatomic(f->nodes.data, f->nodes.nr, sizeof(f->nodes.data[0]), found_btree_node_cmp_cookie, NULL);
+	sort(f->nodes.data, f->nodes.nr, sizeof(f->nodes.data[0]), found_btree_node_cmp_cookie, NULL);
 
 	dst = 0;
 	darray_for_each(f->nodes, i) {
@@ -415,7 +415,7 @@
 	}
 	f->nodes.nr = dst;
 
-	sort_nonatomic(f->nodes.data, f->nodes.nr, sizeof(f->nodes.data[0]), found_btree_node_cmp_pos, NULL);
+	sort(f->nodes.data, f->nodes.nr, sizeof(f->nodes.data[0]), found_btree_node_cmp_pos, NULL);
 
 	if (0 && c->opts.verbose) {
 		printbuf_reset(&buf);
