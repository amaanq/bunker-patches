diff -ruN a/src/fs/bcachefs/init/recovery.c b/src/fs/bcachefs/init/recovery.c
--- a/src/fs/bcachefs/init/recovery.c	2026-11-10 17:23:22.989520627 -0500
+++ b/src/fs/bcachefs/init/recovery.c	2026-11-10 17:23:22.992430855 -0500
