From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: maade93791 <70593890+maade69@users.noreply.github.com>
Date: Mon, 29 Jun 2026 18:22:09 +0300
Subject: [PATCH] usb: gadget: f_ncm: fix double-free in ncm_unbind()

---
 drivers/usb/gadget/function/f_ncm.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/gadget/function/f_ncm.c b/drivers/usb/gadget/function/f_ncm.c
index 12e18221f320a..3285bf22ad8fd 100644
--- a/drivers/usb/gadget/function/f_ncm.c
+++ b/drivers/usb/gadget/function/f_ncm.c
@@ -1730,22 +1730,28 @@ static void ncm_unbind(struct usb_configuration *c, struct usb_function *f)
 	ncm_opts = container_of(f->fi, struct f_ncm_opts, func_inst);
 
 	hrtimer_cancel(&ncm->task_timer);
 
 	kfree(f->os_desc_table);
+	f->os_desc_table = NULL;
 	f->os_desc_n = 0;
 
 	ncm_string_defs[0].id = 0;
 	usb_free_all_descriptors(f);
 
 	if (atomic_read(&ncm->notify_count)) {
-		usb_ep_dequeue(ncm->notify, ncm->notify_req);
+		if (ncm->notify_req)
+			usb_ep_dequeue(ncm->notify, ncm->notify_req);
 		atomic_set(&ncm->notify_count, 0);
 	}
 
-	kfree(ncm->notify_req->buf);
-	usb_ep_free_request(ncm->notify, ncm->notify_req);
+	if (ncm->notify_req) {
+		kfree(ncm->notify_req->buf);
+		ncm->notify_req->buf = NULL;
+		usb_ep_free_request(ncm->notify, ncm->notify_req);
+		ncm->notify_req = NULL;
+	}
 
 	ncm_opts->bind_count--;
 	if (ncm_opts->bind_count == 0)
 		gether_detach_gadget(ncm_opts->net);
 }
-- 
