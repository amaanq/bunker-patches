+{
+	static const unsigned prio_map =
+		7 << (4 * 0) |
+		6 << (4 * 1) |
+		5 << (4 * 2) |
+		4 << (4 * 3) |
+		3 << (4 * 4) |
+		2 << (4 * 5) |
+		0 << (4 * 6) |
+		1 << (4 * 7);
+
+	return (prio_map >> ((prio & 0x7) << 2)) & 0x7;
