+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * cvmx-error.h — empty stub.
+ *
+ * The full Cavium SDK 5.1 cvmx-error.h plus cvmx-error-trees.c implements
+ * a runtime error-tree dispatcher that walks per-block error registers and
+ * routes interrupts to per-error handlers. The ethernet bring-up does not
+ * use it; mainline 6.18 has no equivalent. Provide an empty stub so headers
+ * that #include <asm/octeon/cvmx-error.h> in their kernel arm continue to
+ * compile.
+ */
+#ifndef __CVMX_ERROR_H__
+#define __CVMX_ERROR_H__
+
+enum cvmx_error_groups {
+	CVMX_ERROR_GROUP_INTERNAL = 0,
+	CVMX_ERROR_GROUP_LMC,
+	CVMX_ERROR_GROUP_ETHERNET,
+	CVMX_ERROR_GROUP_MGMT_PORT,
+	CVMX_ERROR_GROUP_PCI,
+	CVMX_ERROR_GROUP_SRIO,
+	CVMX_ERROR_GROUP_USB,
+	CVMX_ERROR_GROUP_PKO,
+	CVMX_ERROR_GROUP_TIM,
+	CVMX_ERROR_GROUP_RAD,
+	CVMX_ERROR_GROUP_KEY,
+	CVMX_ERROR_GROUP_FPA,
+	CVMX_ERROR_GROUP_DFA,
+	CVMX_ERROR_GROUP_ZIP,
+	CVMX_ERROR_GROUP_RNM,
+	CVMX_ERROR_GROUP_ILK,
+	CVMX_ERROR_GROUP_DPI,
+	CVMX_ERROR_GROUP_AGL,
+	CVMX_ERROR_GROUP_MIO,
+};
+
+#endif /* __CVMX_ERROR_H__ */
