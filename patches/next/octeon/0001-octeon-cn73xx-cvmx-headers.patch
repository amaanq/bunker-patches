+#define memory_order_seq_cst __ATOMIC_SEQ_CST
+#define memory_order_acquire __ATOMIC_ACQUIRE
+#define memory_order_release __ATOMIC_RELEASE
+#define memory_order_relaxed __ATOMIC_RELAXED
