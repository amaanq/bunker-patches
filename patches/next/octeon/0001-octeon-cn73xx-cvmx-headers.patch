+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * cvmx-helper-sfp.h — empty stub.
+ *
+ * The Cavium SDK 5.1 cvmx-helper-sfp.h pulls in libfdt + a Cavium-specific
+ * SFP module-EEPROM helper that is irrelevant for the EdgeRouter Infinity
+ * port: BGX SFP+ link bring-up is driven from cvmx-helper-bgx.c, which
+ * handles the GSER lane sequencing without consulting an EEPROM. Provide
+ * an empty stub so cvmx-helper.c (which #includes this header in its
+ * kernel arm) compiles. If a future port wants real SFP module probing,
+ * lift the relevant subset of EdgeOS u-boot/include/sfp.c into here.
+ */
+#ifndef __CVMX_HELPER_SFP_H__
+#define __CVMX_HELPER_SFP_H__
+#endif /* __CVMX_HELPER_SFP_H__ */
