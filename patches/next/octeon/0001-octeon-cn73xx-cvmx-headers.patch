+	struct cvmx_pki_stylex_tag_sel_s      cn78xxp1;
+	struct cvmx_pki_stylex_tag_sel_s      cnf75xx;
+};
+typedef union cvmx_pki_stylex_tag_sel cvmx_pki_stylex_tag_sel_t;
