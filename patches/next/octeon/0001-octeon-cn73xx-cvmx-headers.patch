+#ifdef CVMX_CAVIUM_OCTEON2
+	{
+		__asm__ __volatile__(".set push         \n"
+				     "   saad %[inc], (%[base])  \n"
+				     ".set pop          \n":"+m"(*ptr)
+				     :[inc] "r"(incr),[base] "r"(ptr)
+				     :"memory");
+	}
+#else
+	if (OCTEON_IS_MODEL(OCTEON_CN3XXX)) {
+		uint64_t tmp;
+		__asm__ __volatile__(".set push         \n"
+				     ".set noreorder         \n"
+				     "1: lld  %[tmp], %[val] \n"
+				     "   daddu %[tmp], %[inc] \n"
+				     "   scd  %[tmp], %[val] \n"
+				     "   beqz %[tmp], 1b     \n" "   nop                 \n" ".set pop           \n":[val] "+m"(*ptr),[tmp] "=&r"(tmp)
+				     :[inc] "r"(incr)
+				     :"memory");
+	} else {
+		__asm__ __volatile__(".set push         \n"
+				     "   saad %[inc], (%[base])  \n"
+				     ".set pop          \n":"+m"(*ptr)
+				     :[inc] "r"(incr),[base] "r"(ptr)
+				     :"memory");
+	}
+#endif
+}
