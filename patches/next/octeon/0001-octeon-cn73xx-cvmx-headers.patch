+	uint64_t reserved_9_15                : 7;
+	uint64_t val                          : 1;  /**< Table entry is valid */
+	uint64_t reserved_6_7                 : 2;
+	uint64_t bpid                         : 6;  /**< Backpressure ID the entry maps to */
+#else
